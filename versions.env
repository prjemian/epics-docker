# versions.env -- single source of truth for component versions (v3)
#
# Shell KEY=value format. Sourced by build scripts and passed to the
# Dockerfile as build ARGs (see Makefile). Keep every externally-pinned
# version here and nowhere else, so upgrades are a one-file edit.
#
# Format rules:
#   - one KEY=VALUE per line, no spaces around '='
#   - no trailing comments on value lines (keep values clean for ARG use)
#   - values are unquoted

# ---------------------------------------------------------------- image
# Version of THIS project's image recipe (not any EPICS component).
IMAGE_VERSION=3.0.0-dev

# Base OS image (Debian). Pin to a specific tag for reproducibility.
DEBIAN_TAG=12-slim

# ---------------------------------------------------------------- EPICS base
# https://epics.anl.gov/download/base/
EPICS_BASE_VERSION=7.0.10

# ---------------------------------------------------------------- procServ
# IOC process supervisor (replaces `screen`).
# Installed from Debian packages in base-os for now; pinned here for
# reference and in case we later build from source.
# https://github.com/ralphlange/procServ
PROCSERV_VERSION=2.8.0
