# versions.env -- single source of truth for component versions (v3)
#
# Shell KEY=value format. Sourced by build scripts and passed to the
# Dockerfile as build ARGs (see Makefile). Keep every externally-pinned
# version here and nowhere else, so upgrades are a one-file edit.
#
# Format rules:
#   - one KEY=VALUE per line, no spaces around '='
#   - no trailing comments on value lines (keep values clean for ARG use)
#   - values are unquoted

# ---------------------------------------------------------------- image
# Version of THIS project's image recipe (not any EPICS component).
IMAGE_VERSION=3.0.0-dev

# Base OS image (Debian). Pin to a specific tag for reproducibility.
DEBIAN_TAG=12-slim

# ---------------------------------------------------------------- EPICS base
# https://epics.anl.gov/download/base/
EPICS_BASE_VERSION=7.0.10

# ---------------------------------------------------------------- synApps
# Release tag of the EPICS-synApps/support assembler. Selects which
# assemble_synApps.sh we download; that script carries a self-consistent,
# release-matched set of module tags. Upgrade synApps by bumping ONLY this.
# https://github.com/EPICS-synApps/support/releases
SYNAPPS_VERSION=R6-3

# --- synApps module version OVERRIDES ---------------------------------------
# Normally we inherit each module's tag from the synApps release (do NOT
# re-pin). List overrides here ONLY with a documented reason; each is a
# deliberate exception to the "inherit release tags" policy. Format:
#   MODULE=TAG   (MODULE is the assemble_synApps.sh variable name)
# synapps_prepare.sh applies these after excluding hardware modules.
#
# MOTOR: R6-3 pins motor R7-2-2, whose motorApp/MotorSrc/motordrvCom.h uses
#   epicsShareFunc without including <shareLib.h>. That transitive include is
#   absent with modern EPICS base + GCC 12 (Debian 12), so R7-2-2 fails to
#   compile ("'epicsShareFunc' does not name a type"). motor R7-3-1 fixes the
#   include. Remove this override when a synApps release ships a fixed motor.
SYNAPPS_OVERRIDE_MOTOR=R7-3-1

# ---------------------------------------------------------------- procServ
# IOC process supervisor (replaces `screen`).
# Installed from Debian packages in base-os for now; pinned here for
# reference and in case we later build from source.
# https://github.com/ralphlange/procServ
PROCSERV_VERSION=2.8.0
