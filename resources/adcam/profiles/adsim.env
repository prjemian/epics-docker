# adcam profile: ADSimDetector (custom simulated area detector).
# Hardware-free. Built by the assembler (ADSIMDETECTOR enabled), so its
# example IOC exists and we only customize a copy.

CAM_NAME=adsim
CAM_PREFIX=adsim:
CAM_SRC_IOC=ADSimDetector/iocs/simDetectorIOC/iocBoot/iocSimDetector
CAM_STOCK_PREFIX=13SIM1:
CAM_KEEP_CAM2=no
CAM_HOST_DEVICE=          # none (fully simulated)
