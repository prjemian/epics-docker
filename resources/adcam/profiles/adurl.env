# adcam profile: ADURL (area detector reading images from a URL).
# Hardware-free (needs GraphicsMagick, already a runtime dep).
CAM_NAME=adurl
CAM_PREFIX=adurl:
CAM_SRC_IOC=ADURL/iocs/urlIOC/iocBoot/iocURLDriver
CAM_STOCK_PREFIX=13URL1:
CAM_KEEP_CAM2=no
CAM_APP=URLDriverApp
CAM_HOST_DEVICE=          # none (fetches images from a URL)
