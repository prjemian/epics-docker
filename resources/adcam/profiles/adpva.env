# adcam profile: pvaDriver (area detector reading images from pvAccess).
# Hardware-free (consumes a PVA image source, e.g. another AD IOC's Pva1:).
CAM_NAME=adpva
CAM_PREFIX=adpva:
CAM_SRC_IOC=pvaDriver/iocs/pvaDriverIOC/iocBoot/iocPvaDriver
CAM_STOCK_PREFIX=13PVA1:
CAM_KEEP_CAM2=no
CAM_APP=pvaDriverApp
CAM_HOST_DEVICE=          # none (consumes a pvAccess image channel)
